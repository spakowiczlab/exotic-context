{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release manifest",
  "type": "object",
  "required": [
    "schema_version",
    "release_id",
    "dataset_id",
    "profile_id",
    "source_commit",
    "created_at",
    "input_manifest_sha256",
    "profile_sha256",
    "status",
    "qc_summary",
    "citations",
    "sample_status",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "input_manifest_sha256": {
      "type": "string",
      "minLength": 1
    },
    "profile_sha256": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "qc_summary": {
      "type": "object"
    },
    "citations": {
      "type": "array"
    },
    "sample_status": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Sample outcome",
        "type": "object",
        "required": [
          "sample_id",
          "status",
          "reason"
        ],
        "properties": {
          "sample_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "success",
              "excluded",
              "failed"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "External output",
        "type": "object",
        "required": [
          "product",
          "url",
          "size_bytes",
          "sha256",
          "format",
          "units"
        ],
        "properties": {
          "product": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "format": {
            "type": "string"
          },
          "units": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
