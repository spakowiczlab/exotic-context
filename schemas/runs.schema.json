{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parsed run TSV row",
  "type": "object",
  "required": [
    "run_id",
    "sample_id",
    "source_run_id",
    "layout",
    "read_1_url",
    "read_1_sha256",
    "read_2_url",
    "read_2_sha256"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "source_run_id": {
      "type": "string",
      "minLength": 1
    },
    "layout": {
      "enum": [
        "single",
        "paired"
      ]
    },
    "read_1_url": {
      "type": "string",
      "minLength": 1
    },
    "read_1_sha256": {
      "type": "string",
      "pattern": "^([a-fA-F0-9]{64}|unknown)$"
    },
    "read_2_url": {
      "type": "string",
      "minLength": 1
    },
    "read_2_sha256": {
      "type": "string",
      "pattern": "^([a-fA-F0-9]{64}|unknown)$"
    }
  },
  "additionalProperties": true
}
